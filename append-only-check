#!/bin/sh
#
# append-only-check: advisory pre-commit hook for append-only directories.
#
# Warns when a commit modifies, deletes or renames a file in a directory that
# should only ever be added to (database migrations, Alembic versions, ...).
# The commit is NOT blocked unless `git config appendOnly.strict true` is set.
#
# Protected paths are read from `.append-only-paths` in the repository root:
# one pattern per line, `#` comments and blank lines ignored. Each pattern
# matches a file exactly or anything beneath it as a directory, and may use
# shell globs, where `*` also matches `/`:
#
#     database/migrations/
#     alembic/versions/
#     */migrations/          # Django: every app's migrations directory
#
# A file is only treated as "shipped" (and therefore protected) if it exists on
# the base ref, by default the remote's default branch (origin/HEAD, falling
# back to origin/main then origin/master). Editing a migration that so far only
# exists on your own feature branch is fine and produces no warning. Override
# the base with `git config appendOnly.baseRef <ref>`. If no base ref can be
# found, every already-committed file in a protected path is treated as shipped.

set -u

CONFIG_FILE=.append-only-paths

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$top" || exit 0
[ -f "$CONFIG_FILE" ] || exit 0

# Normalise patterns: drop CRs (Windows checkouts), surrounding whitespace,
# comments, blank lines and any trailing slash.
patterns=$(tr -d '\r' < "$CONFIG_FILE" | sed \
    -e 's/^[[:space:]]*//' \
    -e 's/[[:space:]]*$//' \
    -e '/^#/d' \
    -e '/^$/d' \
    -e 's|/*$||')
[ -n "$patterns" ] || exit 0

ref_exists() {
    git rev-parse -q --verify "$1^{commit}" >/dev/null 2>&1
}

base=$(git config --get appendOnly.baseRef 2>/dev/null || true)
if [ -n "$base" ]; then
    if ! ref_exists "$base"; then
        echo "append-only-check: appendOnly.baseRef '$base' not found;" \
            "treating all committed files as shipped." >&2
        base=
    fi
else
    base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -z "$base" ] || ! ref_exists "$base"; then
        base=
        for candidate in origin/main origin/master; do
            if ref_exists "$candidate"; then
                base=$candidate
                break
            fi
        done
    fi
fi

is_protected() {
    # Each pattern is deliberately unquoted in `case` so shell globs apply.
    # `case` patterns and here-doc bodies are never pathname-expanded, so no
    # `set -f` or IFS juggling is needed.
    while IFS= read -r pattern; do
        # shellcheck disable=SC2254
        case $1 in
            $pattern | $pattern/*) return 0 ;;
        esac
    done <<EOF
$patterns
EOF
    return 1
}

is_shipped() {
    # $1 = status letter, $2 = path
    [ -z "$base" ] && return 0
    base_blob=$(git rev-parse -q --verify "$base:$2" 2>/dev/null) || return 1
    # Restoring a file to exactly its shipped content is welcome, not a problem.
    if [ "$1" != D ]; then
        # ":0:" names stage 0 explicitly; a bare ":$2" would misread a path
        # such as "1:foo" as a stage number.
        index_blob=$(git rev-parse -q --verify ":0:$2" 2>/dev/null || true)
        [ "$index_blob" = "$base_blob" ] && return 1
    fi
    return 0
}

tab=$(printf '\t')
# --no-renames reports a rename as delete + add, so the old path is caught.
changes=$(git -c core.quotePath=false diff --cached --name-status \
    --no-renames --diff-filter=MDT 2>/dev/null)
[ -n "$changes" ] || exit 0

hits=$(printf '%s\n' "$changes" | while IFS=$tab read -r status path; do
    [ -n "$path" ] || continue
    is_protected "$path" || continue
    is_shipped "$status" "$path" || continue
    case $status in
        D) label='deleted: ' ;;
        T) label='retyped: ' ;;
        *) label='modified:' ;;
    esac
    printf '    %s %s\n' "$label" "$path"
done)
[ -n "$hits" ] || exit 0

strict=$(git config --bool --get appendOnly.strict 2>/dev/null || echo false)

if [ -t 2 ]; then
    yellow=$(printf '\033[1;33m')
    reset=$(printf '\033[0m')
else
    yellow=
    reset=
fi

{
    echo
    echo "${yellow}WARNING: this commit changes files in append-only paths${reset}"
    echo
    echo "$hits"
    echo
    echo "  These paths are listed in $CONFIG_FILE. Files there (e.g. database"
    echo "  migrations) may already have been run on other machines or in"
    echo "  production, so editing them retrospectively has no effect there and"
    echo "  makes environments drift. Add a NEW file that makes the correction"
    echo "  instead."
    echo
    if [ "$strict" = true ]; then
        echo "  Commit blocked (appendOnly.strict). If this really is intended,"
        echo "  re-run with --no-verify and explain why in the pull request."
    else
        echo "  The commit will go ahead. If this is intentional, please explain"
        echo "  why in the pull request so reviewers aren't surprised."
    fi
    echo
} >&2

[ "$strict" = true ] && exit 1
exit 0
